{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'if ! command -v entire >/dev/null 2>&1; then exit 0; fi; exec entire hooks claude-code post-task'"
          }
        ]
      },
      {
        "matcher": "TaskCreate|TaskUpdate",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'if ! command -v entire >/dev/null 2>&1; then exit 0; fi; exec entire hooks claude-code post-todo'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'if ! command -v entire >/dev/null 2>&1; then exit 0; fi; exec entire hooks claude-code pre-task'"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'if ! command -v entire >/dev/null 2>&1; then exit 0; fi; exec entire hooks claude-code session-end'"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'if ! command -v entire >/dev/null 2>&1; then printf \"%s\\n\" \"{\\\"systemMessage\\\":\\\"\\\\n\\\\nEntire CLI is enabled but not installed or not on PATH.\\\\nInstallation guide: https://docs.entire.io/cli/installation#installation-methods\\\"}\"; exit 0; fi; exec entire hooks claude-code session-start'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'if ! command -v entire >/dev/null 2>&1; then exit 0; fi; exec entire hooks claude-code stop'"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'if ! command -v entire >/dev/null 2>&1; then exit 0; fi; exec entire hooks claude-code user-prompt-submit'"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(./.entire/metadata/**)"
    ],
    "allow": [
      "mcp__neuvector__nv_whoami",
      "mcp__neuvector__nv_get_system_summary",
      "mcp__neuvector__nv_get_system_alerts",
      "mcp__neuvector__nv_list_enforcers",
      "mcp__neuvector__nv_list_hosts",
      "mcp__neuvector__nv_list_namespaces",
      "mcp__neuvector__nv_list_services",
      "mcp__neuvector__nv_list_workloads",
      "mcp__neuvector__nv_get_workload",
      "mcp__neuvector__nv_list_groups",
      "mcp__neuvector__nv_get_group",
      "mcp__neuvector__nv_list_network_rules",
      "mcp__neuvector__nv_get_network_rule",
      "mcp__neuvector__nv_get_network_conversations",
      "mcp__neuvector__nv_get_process_profile",
      "mcp__neuvector__nv_get_file_monitor_profile",
      "mcp__neuvector__nv_list_response_rules",
      "mcp__neuvector__nv_list_waf_sensors",
      "mcp__neuvector__nv_get_waf_sensor",
      "mcp__neuvector__nv_list_waf_rules",
      "mcp__neuvector__nv_list_waf_groups",
      "mcp__neuvector__nv_get_waf_group",
      "mcp__neuvector__nv_list_dlp_sensors",
      "mcp__neuvector__nv_list_registries",
      "mcp__neuvector__nv_list_registry_images",
      "mcp__neuvector__nv_list_image_scan_summaries",
      "mcp__neuvector__nv_get_scan_report",
      "mcp__neuvector__nv_get_scan_status",
      "mcp__neuvector__nv_list_scanners",
      "mcp__neuvector__nv_get_vulnerability_profile",
      "mcp__neuvector__nv_list_compliance_profiles",
      "mcp__neuvector__nv_get_compliance_profile",
      "mcp__neuvector__nv_get_compliance_findings",
      "mcp__neuvector__nv_get_bench_report",
      "mcp__neuvector__nv_list_admission_rules",
      "mcp__neuvector__nv_get_admission_state",
      "mcp__neuvector__nv_assess_admission_rule",
      "mcp__neuvector__nv_get_threat_detail",
      "mcp__neuvector__nv_query_security_events",
      "mcp__neuvector__nv_query_audit_events",
      "mcp__neuvector__nv_query_system_events",
      "mcp__neuvector__nv_create_waf_sensor",
      "mcp__neuvector__nv_update_waf_sensor",
      "mcp__neuvector__nv_delete_waf_sensor",
      "mcp__neuvector__nv_set_waf_group",
      "Bash(make verify:*)",
      "Bash(make test:*)",
      "Bash(make lint:*)",
      "Bash(make types:*)",
      "Bash(make spec:*)",
      "Bash(make fmt:*)",
      "Bash(make help:*)",
      "Bash(uv run pytest:*)"
    ]
  }
}
